# CuteFinance PWA Environment Configuration
# Copy this file to .env and customize as needed

# Server Configuration
PORT=8080
HOST=0.0.0.0

# Application Mode
NODE_ENV=production

# PWA Configuration
PWA_NAME=CuteFinance
PWA_SHORT_NAME=CuteFinance
PWA_THEME_COLOR=#FFF9C4
PWA_BACKGROUND_COLOR=#FFF9C4

# Database (for future backend integration)
# DB_PATH=/data/cutefinance.db

# Tailscale Configuration (optional)
# TAILSCALE_HOSTNAME=cutefinance.ts.net

# Notification Settings
# ENABLE_PUSH_NOTIFICATIONS=true
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key

# Analytics (optional)
# ENABLE_ANALYTICS=false
# ANALYTICS_ID=

# Security
# CORS_ORIGIN=http://localhost:8080
# RATE_LIMIT=100
