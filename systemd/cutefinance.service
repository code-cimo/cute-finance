[Unit]
Description=CuteFinance PWA - Personal Finance Manager
Documentation=https://github.com/yourusername/cutefinance-pwa
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/cutefinance

# Serve with Python HTTP server (simple) or use Nginx
ExecStart=/usr/bin/python3 -m http.server 8080 --directory /var/www/cutefinance

Restart=always
RestartSec=10

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/cutefinance

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cutefinance

[Install]
WantedBy=multi-user.target
